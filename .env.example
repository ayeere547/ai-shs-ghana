# ---------------------------------------------------------------------------
# AI SHS Ghana — environment variables. Copy to .env.local and fill in.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser.
# ---------------------------------------------------------------------------

# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used solely for auth-admin operations (staff invitations).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in auth email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# Public contact address shown on /contact
NEXT_PUBLIC_SUPPORT_EMAIL=

# Database connection for `npm run db:migrate` / `npm run admin:grant` (session-mode connection string)
DATABASE_URL=
# Optional path to Supabase's CA certificate for verified TLS
DATABASE_SSL_CA=

# --- Phase 4: AI (OpenAI or any OpenAI-compatible endpoint) --------------
# Without OPENAI_API_KEY the AI tutor and teacher tools are disabled; the knowledge base still
# works with keyword search. AI also needs SUPABASE_SERVICE_ROLE_KEY (usage/tutor messages are
# written server-side).
OPENAI_API_KEY=
# Default https://api.openai.com/v1 — point at any OpenAI-compatible API to switch providers.
OPENAI_BASE_URL=
# Models (change without code changes). OPENAI_MODEL is the fallback for both.
OPENAI_MODEL=gpt-4o-mini
AI_MODEL_TUTOR=
AI_MODEL_TEACHER=
# Must produce 1536-dimension vectors (matches knowledge_chunks.embedding).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MODERATION_MODEL=omni-moderation-latest
# Set to "off" to skip provider moderation (local safety checks always run).
AI_MODERATION=
# USD per million tokens, used for cost estimates in usage reports.
AI_PRICE_INPUT_PER_M=0.15
AI_PRICE_OUTPUT_PER_M=0.60
AI_PRICE_EMBEDDING_PER_M=0.02
AI_TIMEOUT_MS=60000

# --- Phase 5: notifications ------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Phase 6: payments (GHS) ----------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
